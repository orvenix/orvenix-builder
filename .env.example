# ============================================================================
# ORVENIX - VARIABLES DE ENTORNO DE EJEMPLO
# ============================================================================
# Copia este archivo a .env para produccion o .env.local para desarrollo.
# Nunca pegues secretos reales en este archivo si lo vas a versionar.
# Los valores con <...> son placeholders y deben reemplazarse en el servidor.
# ============================================================================

# Entorno
NODE_ENV="production"

# Persistencia
# "prisma" usa MariaDB/MySQL via DATABASE_URL. "file" solo para desarrollo simple.
ORVENIX_STORAGE_MODE="prisma"
DATABASE_URL="mysql://<USER>:<PASSWORD>@<HOST>:3306/<DATABASE>"

# Auth
# Generar con: openssl rand -base64 32
AUTH_SECRET="<GENERATED_AUTH_SECRET>"
NEXTAUTH_SECRET="<GENERATED_AUTH_SECRET>"
NEXTAUTH_URL="https://orvenix.com.mx"
AUTH_URL="https://orvenix.com.mx"
NEXT_PUBLIC_API_URL="https://orvenix.com.mx"
ORVENIX_ADMIN_EMAILS="admin@orvenix.com.mx"

# Sitio de marketing opcional
ORVENIX_MARKETING_SITE_ID=""
NEXT_PUBLIC_ORVENIX_MARKETING_SITE_ID=""

# Email transaccional - Resend
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM="Orvenix <contacto@orvenix.com.mx>"

# IA - Anthropic Claude
ANTHROPIC_API_KEY="<ANTHROPIC_API_KEY>"

# Stripe - suscripciones
# Recomendado para produccion: Restricted API Key (rk_live_...) con permisos minimos.
# STRIPE_SECRET_KEY sigue aceptando sk_/rk_ porque la integracion lee este nombre.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="<STRIPE_PUBLISHABLE_KEY>"
STRIPE_SECRET_KEY="<STRIPE_RESTRICTED_OR_SECRET_KEY>"
STRIPE_WEBHOOK_SECRET="<STRIPE_WEBHOOK_SECRET>"
STRIPE_BILLING_PORTAL_CONFIGURATION_ID="<STRIPE_BILLING_PORTAL_CONFIGURATION_ID_OPTIONAL>"
STRIPE_PRICE_STARTER_MONTH="<STRIPE_PRICE_STARTER_MONTH>"
STRIPE_PRICE_STARTER_YEAR="<STRIPE_PRICE_STARTER_YEAR>"
STRIPE_PRICE_PRO_MONTH="<STRIPE_PRICE_PRO_MONTH>"
STRIPE_PRICE_PRO_YEAR="<STRIPE_PRICE_PRO_YEAR>"
STRIPE_PRICE_COMMERCE_MONTH="<STRIPE_PRICE_COMMERCE_MONTH>"
STRIPE_PRICE_COMMERCE_YEAR="<STRIPE_PRICE_COMMERCE_YEAR>"

# MercadoPago - tienda y pagos unicos
MP_ACCESS_TOKEN="<MERCADOPAGO_ACCESS_TOKEN>"
MP_PUBLIC_KEY="<MERCADOPAGO_PUBLIC_KEY>"
MP_SANDBOX="false"

# Deploy DB
# Base existente:
# npm run prisma:resolve-baseline
# npm run prisma:deploy-schema
#
# Base nueva:
# npm run prisma:deploy-schema

# Logging opcional
DEBUG=""
