# ============================================================================
# ORVENIX — VARIABLES DE ENTORNO DE EJEMPLO
# ============================================================================
# Copia este archivo a .env para producción o .env.local para desarrollo.
# No pegues secretos reales en este archivo si lo vas a versionar.
# ============================================================================

# Entorno
NODE_ENV="production"

# Persistencia
# "prisma" usa MariaDB/MySQL vía DATABASE_URL. "file" solo para desarrollo simple.
ORVENIX_STORAGE_MODE="prisma"
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Auth
# Generar con: openssl rand -base64 32
AUTH_SECRET="replace_with_generated_secret"
NEXTAUTH_SECRET="replace_with_generated_secret"
NEXTAUTH_URL="https://tudominio.com"
AUTH_URL="https://tudominio.com"
NEXT_PUBLIC_API_URL="https://tudominio.com"
ORVENIX_ADMIN_EMAILS="admin@tudominio.com"

# Sitio de marketing opcional
ORVENIX_MARKETING_SITE_ID=""
NEXT_PUBLIC_ORVENIX_MARKETING_SITE_ID=""

# Email transaccional · Resend
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="Orvenix <contacto@tudominio.com>"

# IA · Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-api03_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Stripe · suscripciones
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_STARTER_MONTH="price_xxxxxxxxxxxxxxxxx"
STRIPE_PRICE_STARTER_YEAR="price_xxxxxxxxxxxxxxxxx"
STRIPE_PRICE_PRO_MONTH="price_xxxxxxxxxxxxxxxxx"
STRIPE_PRICE_PRO_YEAR="price_xxxxxxxxxxxxxxxxx"
STRIPE_PRICE_COMMERCE_MONTH="price_xxxxxxxxxxxxxxxxx"
STRIPE_PRICE_COMMERCE_YEAR="price_xxxxxxxxxxxxxxxxx"

# MercadoPago · tienda y pagos únicos
MP_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MP_PUBLIC_KEY="APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MP_SANDBOX="false"

# Deploy DB
# Base existente:
# npm run prisma:resolve-baseline
# npm run prisma:deploy-schema
#
# Base nueva:
# npm run prisma:deploy-schema

# Logging opcional
DEBUG=""
