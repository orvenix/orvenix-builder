import { NextResponse } from "next/server";
import { getAuthSession } from "@/lib/auth-session";
import {
  getEditorTreeFromDb,
  saveEditorTreeToDb,
} from "@/lib/editorPersistence";
import { canManageSite, type UserRole } from "@/lib/auth";
import { isEditorWebId } from "@/lib/editorWebs";
import { serverDebug, serverError } from "@/lib/server-log";

interface RouteContext {
  params: Promise<{ id: string }>;
}

const MAX_TREE_SIZE_BYTES = 2 * 1024 * 1024;

function isPublicEditorId(id: string): boolean {
  return id === "default-page" || isEditorWebId(id);
}

async function getAuthenticatedUser() {
  const session = await getAuthSession();

  if (!session?.user?.id) {
    return null;
  }

  return {
    id: session.user.id,
    role: (session.user.role ?? "CLIENT") as UserRole,
  };
}

async function canWriteEditorId(id: string): Promise<boolean> {
  const user = await getAuthenticatedUser();

  if (!user) {
    return false;
  }

  /*
   * Los IDs especiales no deben recibir acceso de escritura
   * automáticamente. También deben pertenecer al usuario o estar
   * autorizados explícitamente por canManageSite().
   */
  return canManageSite(id, user.id, user.role);
}

export async function GET(request: Request, context: RouteContext) {
  const { id } = await context.params;
  const page = new URL(request.url).searchParams.get("page") ?? "home";

  if (!id) {
    return NextResponse.json(
      { error: "ID de editor requerido" },
      { status: 400 },
    );
  }

  try {
    /*
     * Mantener esta excepción únicamente cuando estos sitios deban ser
     * realmente públicos. De lo contrario, elimina isPublicEditorId()
     * y exige autenticación también para GET.
     */
    if (!isPublicEditorId(id)) {
      const user = await getAuthenticatedUser();

      if (!user) {
        return NextResponse.json(
          { error: "Autenticación requerida" },
          { status: 401 },
        );
      }

      const allowed = await canManageSite(id, user.id, user.role);

      if (!allowed) {
        return NextResponse.json(
          { error: "Acceso denegado" },
          { status: 403 },
        );
      }
    }

    const tree = await getEditorTreeFromDb(id, page);

    if (!tree) {
      serverDebug(`[API Editor GET] No tree found in DB for ID: ${id}`);
    }

    return NextResponse.json({ tree });
  } catch (error) {
    serverError(`Error fetching editor tree for ID ${id}`, error);

    return NextResponse.json(
      { error: "No se pudo obtener el sitio" },
      { status: 500 },
    );
  }
}

export async function PUT(request: Request, context: RouteContext) {
  const { id } = await context.params;
  const page = new URL(request.url).searchParams.get("page") ?? "home";

  if (!id) {
    return NextResponse.json(
      { error: "ID de editor requerido" },
      { status: 400 },
    );
  }

  try {
    const user = await getAuthenticatedUser();

    if (!user) {
      return NextResponse.json(
        { error: "Autenticación requerida" },
        { status: 401 },
      );
    }

    if (!(await canWriteEditorId(id))) {
      return NextResponse.json(
        { error: "Acceso denegado" },
        { status: 403 },
      );
    }

    const contentLength = Number(request.headers.get("content-length") ?? 0);

    if (contentLength > MAX_TREE_SIZE_BYTES) {
      return NextResponse.json(
        { error: "El contenido del editor excede el tamaño permitido" },
        { status: 413 },
      );
    }

    const body: unknown = await request.json();

    if (
      typeof body !== "object" ||
      body === null ||
      !Object.prototype.hasOwnProperty.call(body, "tree")
    ) {
      return NextResponse.json(
        { error: "El campo tree es obligatorio" },
        { status: 400 },
      );
    }

    const { tree } = body as { tree: unknown };

    const serializedTree = JSON.stringify(tree);

    if (Buffer.byteLength(serializedTree, "utf8") > MAX_TREE_SIZE_BYTES) {
      return NextResponse.json(
        { error: "El contenido del editor excede el tamaño permitido" },
        { status: 413 },
      );
    }

    const savedTree = await saveEditorTreeToDb(id, tree, page);

    return NextResponse.json({
      ok: true,
      tree: savedTree,
    });
  } catch (error) {
    serverError(`Error saving editor tree for ID ${id}`, error);

    if (error instanceof SyntaxError) {
      return NextResponse.json(
        { error: "El cuerpo de la solicitud no contiene JSON válido" },
        { status: 400 },
      );
    }

    return NextResponse.json(
      { error: "No se pudo guardar el editor" },
      { status: 500 },
    );
  }
}
